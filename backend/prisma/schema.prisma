generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  username               String                  @unique @db.VarChar(50)
  email                  String                  @unique @db.VarChar(255)
  phone                  String?                 @unique @db.VarChar(20)
  password               String                  @db.VarChar(255)
  name                   String                  @db.VarChar(100)
  avatar                 String?                 @db.VarChar(500)
  description            String?
  status                 UserStatus              @default(ACTIVE)
  lastLoginAt            DateTime?               @map("last_login_at")
  lastLoginIp            String?                 @map("last_login_ip") @db.VarChar(50)
  loginCount             Int                     @default(0) @map("login_count")
  failedAttempts         Int                     @default(0) @map("failed_attempts")
  lockedUntil            DateTime?               @map("locked_until")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  deletedAt              DateTime?               @map("deleted_at")
  createdBy              String?                 @map("created_by")
  updatedBy              String?                 @map("updated_by")
  auditLogs              AuditLog[]
  captchaBackgrounds     CaptchaBackground[]
  files                  File[]
  sharedByFolderShares   FolderShare[]           @relation("folder_shares_shared_byTousers")
  sharedWithFolderShares FolderShare[]           @relation("folder_shares_shared_with_user_idTousers")
  folders                Folder[]
  notebooks              Notebook[]
  notificationBroadcasts NotificationBroadcast[]
  notificationSettings   NotificationSetting[]
  notifications          Notification[]
  profitReports          ProfitReport[]
  refreshTokens          RefreshToken[]
  securityLogs           SecurityLog[]
  shops                  Shop[]
  talentContactLogs      TalentContactLog[]
  talentFlagConfigs      TalentFlagConfig[]
  talentFlags            TalentFlag[]
  createdTalentTransfers TalentTransfer[]        @relation("talent_transfers_created_byTousers")
  fromTalentTransfers    TalentTransfer[]        @relation("talent_transfers_from_user_idTousers")
  toTalentTransfers      TalentTransfer[]        @relation("talent_transfers_to_user_idTousers")
  talents                Talent[]
  upgradeLogs            UpgradeLog[]            @relation("userUpgradeLogs")
  userRoles              UserRole[]
  backupLogs             BackupLog[]             @relation("userBackupLogs")
  restoreLogs            RestoreLog[]            @relation("userRestoreLogs")
  numberCheckBatches     NumberCheckBatch[]
  numberCheckRecords     NumberCheckRecord[]
  paymentPayerRecords    PaymentRecord[]     @relation("PaymentPayer")
  purchaseReceiptsChecked PurchaseReceipt[]  @relation("PurchaseReceiptChecker")

  @@index([email])
  @@index([username])
  @@index([phone])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique @db.VarChar(50)
  code            String           @unique @db.VarChar(50)
  description     String?          @db.VarChar(255)
  sortOrder       Int              @default(0) @map("sort_order")
  isSystem        Boolean          @default(false) @map("is_system")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  createdBy       String?          @map("created_by")
  updatedBy       String?          @map("updated_by")
  folderShares    FolderShare[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @db.VarChar(100)
  code            String           @unique @db.VarChar(100)
  description     String           @db.VarChar(255)
  type            String           @db.VarChar(50)
  parentId        String?          @map("parent_id")
  sortOrder       Int              @default(0) @map("sort_order")
  icon            String?          @db.VarChar(100)
  path            String?          @db.VarChar(255)
  component       String?          @db.VarChar(255)
  hidden          Boolean          @default(false)
  keepAlive       Boolean          @default(false) @map("keep_alive")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  parent          Permission?      @relation("PermissionHierarchy", fields: [parentId], references: [id])
  children        Permission[]     @relation("PermissionHierarchy")
  rolePermissions RolePermission[]

  @@index([code])
  @@index([type])
  @@index([parentId])
  @@index([isActive])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  dataScope    String?    @map("data_scope") @db.VarChar(50)
  createdAt    DateTime   @default(now()) @map("created_at")
  createdBy    String?    @map("created_by")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model File {
  id                 String             @id @default(uuid())
  name               String             @db.VarChar(255)
  originalName       String             @map("original_name") @db.VarChar(255)
  mimeType           String             @map("mime_type") @db.VarChar(100)
  extension          String             @db.VarChar(20)
  size               BigInt
  md5                String?            @db.VarChar(32)
  storageType        StorageType        @default(RUSTFS) @map("storage_type")
  bucket             String             @db.VarChar(100)
  path               String             @db.VarChar(500)
  url                String             @db.VarChar(500)
  thumbnailUrl       String?            @map("thumbnail_url") @db.VarChar(500)
  access             FileAccess         @default(PRIVATE)
  shareCode          String?            @unique @map("share_code") @db.VarChar(32)
  shareExpireAt      DateTime?          @map("share_expire_at")
  status             String?            @default("ACTIVE") @db.VarChar(20)
  quarantinedAt      DateTime?          @map("quarantined_at")
  quarantineReason   String?            @map("quarantine_reason") @db.VarChar(500)
  quarantinePath     String?            @map("quarantine_path") @db.VarChar(500)
  virusScanResult    String?            @map("virus_scan_result") @db.VarChar(100)
  virusScanAt        DateTime?          @map("virus_scan_at")
  folderId           String?            @map("folder_id")
  uploadedBy         String             @map("uploaded_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  category           FileCategory       @default(OTHER)
  duration           Int?
  height             Int?
  sha256             String?            @db.VarChar(64)
  width              Int?
  shareAccess        String?            @map("share_access") @db.VarChar(20)
  sharePassword      String?            @map("share_password") @db.VarChar(100)
  source             FileSource         @default(UPLOAD)
  folder             Folder?            @relation(fields: [folderId], references: [id])
  user               User               @relation(fields: [uploadedBy], references: [id])
  numberCheckBatches NumberCheckBatch[]
  paymentBills       PaymentBill[]       @relation("PaymentBillFile")
  paymentAttachments PaymentAttachment[] @relation("PaymentAttachmentFile")
  purchaseReceiptImages PurchaseReceiptImage[] @relation("PurchaseReceiptImageFile")

  @@index([folderId])
  @@index([uploadedBy])
  @@index([access])
  @@index([shareCode])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([category])
  @@index([md5])
  @@index([source])
  @@map("files")
}

model Folder {
  id             String          @id @default(uuid())
  name           String          @db.VarChar(255)
  description    String?         @db.VarChar(500)
  icon           String?         @db.VarChar(50)
  sortOrder      Int             @default(0) @map("sort_order")
  parentId       String?         @map("parent_id")
  realFolderId   String?         @map("real_folder_id")
  isVirtual      Boolean         @default(false) @map("is_virtual")
  isSystem       Boolean         @default(false) @map("is_system")
  shareType      FolderShareType @default(NONE) @map("share_type")
  isSystemShared Boolean         @default(false) @map("is_system_shared")
  access         FileAccess      @default(PRIVATE)
  createdBy      String          @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  files          File[]
  folderShares   FolderShare[]
  user           User            @relation(fields: [createdBy], references: [id])
  parent         Folder?         @relation("FolderHierarchy", fields: [parentId], references: [id])
  children       Folder[]        @relation("FolderHierarchy")
  realFolder     RealFolder?     @relation(fields: [realFolderId], references: [id])
  uploadSessions UploadSession[]

  @@index([parentId])
  @@index([createdBy])
  @@index([access])
  @@index([deletedAt])
  @@index([realFolderId])
  @@index([shareType])
  @@map("folders")
}

model Config {
  id          String    @id @default(uuid())
  key         String    @unique @db.VarChar(100)
  value       String
  type        String    @db.VarChar(50)
  description String?   @db.VarChar(255)
  category    String    @db.VarChar(50)
  sortOrder   Int       @default(0) @map("sort_order")
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("configs")
}

model Dictionary {
  id          String    @id @default(uuid())
  typeCode    String    @map("type_code") @db.VarChar(50)
  typeName    String    @map("type_name") @db.VarChar(100)
  itemCode    String    @map("item_code") @db.VarChar(50)
  itemName    String    @map("item_name") @db.VarChar(100)
  itemValue   String    @map("item_value") @db.VarChar(255)
  sortOrder   Int       @default(0) @map("sort_order")
  isDefault   Boolean   @default(false) @map("is_default")
  isActive    Boolean   @default(true) @map("is_active")
  description String?   @db.VarChar(255)
  color       String?   @db.VarChar(20)
  icon        String?   @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([typeCode, itemCode])
  @@index([typeCode])
  @@index([isActive])
  @@index([deletedAt])
  @@map("dictionaries")
}

model AuditLog {
  id            String      @id @default(uuid())
  action        AuditAction
  module        String      @db.VarChar(50)
  resource      String      @db.VarChar(100)
  resourceId    String?     @map("resource_id") @db.VarChar(100)
  description   String?     @db.VarChar(500)
  oldValue      String?     @map("old_value")
  newValue      String?     @map("new_value")
  diff          String?
  userId        String?     @map("user_id")
  username      String?     @db.VarChar(100)
  realName      String?     @map("real_name") @db.VarChar(100)
  ip            String      @db.VarChar(50)
  userAgent     String?     @map("user_agent")
  requestUrl    String      @map("request_url") @db.VarChar(500)
  requestMethod String      @map("request_method") @db.VarChar(10)
  requestParams String?     @map("request_params")
  executionTime Int         @map("execution_time")
  status        String      @db.VarChar(20)
  errorMessage  String?     @map("error_message")
  createdAt     DateTime    @default(now()) @map("created_at")
  user          User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([resource])
  @@index([resourceId])
  @@index([status])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id         String    @id @default(uuid())
  token      String    @unique @db.VarChar(500)
  expiresAt  DateTime  @map("expires_at")
  userId     String    @map("user_id")
  deviceId   String?   @map("device_id") @db.VarChar(100)
  deviceName String?   @map("device_name") @db.VarChar(100)
  ip         String?   @db.VarChar(50)
  userAgent  String?   @map("user_agent")
  isRevoked  Boolean   @default(false) @map("is_revoked")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([deviceId])
  @@index([isRevoked])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UploadSession {
  id             String       @id @default(uuid())
  fileName       String       @map("file_name") @db.VarChar(255)
  fileSize       BigInt       @map("file_size")
  fileMd5        String       @map("file_md5") @db.VarChar(32)
  mimeType       String       @map("mime_type") @db.VarChar(100)
  extension      String       @db.VarChar(20)
  chunkSize      Int          @default(5242880) @map("chunk_size")
  chunkCount     Int          @map("chunk_count")
  uploadedChunks Int          @default(0) @map("uploaded_chunks")
  chunks         Json?
  storageType    StorageType  @default(RUSTFS) @map("storage_type")
  bucket         String       @db.VarChar(100)
  fileKey        String?      @map("file_key") @db.VarChar(500)
  status         UploadStatus @default(PENDING) @map("status")
  folderId       String?      @map("folder_id")
  uploadedBy     String       @map("uploaded_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  expiresAt      DateTime     @map("expires_at")
  folder         Folder?      @relation(fields: [folderId], references: [id])

  @@index([fileMd5])
  @@index([status])
  @@index([uploadedBy])
  @@index([folderId])
  @@index([expiresAt])
  @@map("upload_sessions")
}

model FileFormatConfig {
  id          String        @id @default(uuid())
  extension   String        @unique @db.VarChar(20)
  displayName String        @map("display_name") @db.VarChar(100)
  mimeTypes   Json          @map("mime_types")
  minSize     BigInt        @default(0) @map("min_size")
  maxSize     BigInt        @map("max_size")
  category    FileCategory?
  isEnabled   Boolean       @default(true) @map("is_enabled")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([category])
  @@index([isEnabled])
  @@map("file_format_configs")
}

model RecycleBin {
  id           String    @id @default(uuid())
  originalId   String    @map("original_id")
  originalType String    @map("original_type") @db.VarChar(20)
  name         String    @db.VarChar(255)
  path         String    @db.VarChar(500)
  size         BigInt?
  deletedBy    String    @map("deleted_by")
  deletedAt    DateTime  @default(now()) @map("deleted_at")
  purgeAt      DateTime  @map("purge_at")
  restoredAt   DateTime? @map("restored_at")
  restoredBy   String?   @map("restored_by")

  @@index([originalType])
  @@index([deletedBy])
  @@index([deletedAt])
  @@index([purgeAt])
  @@map("recycle_bin")
}

model AiModel {
  id          String    @id @default(uuid())
  name        String    @unique
  displayName String    @map("display_name")
  provider    String
  modelId     String    @map("model_id")
  apiEndpoint String?   @map("api_endpoint")
  description String?
  isEnabled   Boolean   @default(true) @map("is_enabled")
  isDefault   Boolean   @default(false) @map("is_default")
  isFree      Boolean   @default(false) @map("is_free")
  sortOrder   Int       @default(0) @map("sort_order")
  config      Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([isDefault])
  @@index([isEnabled])
  @@index([provider])
  @@index([sortOrder])
  @@map("ai_models")
}

model AiUsageLog {
  id               String   @id @default(uuid())
  modelId          String   @map("model_id")
  userId           String   @map("user_id")
  actionType       String   @map("action_type")
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  cost             Decimal  @default(0) @db.Decimal(10, 6)
  responseTime     Int      @default(0) @map("response_time")
  success          Boolean  @default(true)
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([actionType])
  @@index([modelId, createdAt])
  @@index([success])
  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

model CaptchaBackground {
  id          String    @id @default(uuid())
  fileName    String    @map("file_name") @db.VarChar(255)
  filePath    String    @map("file_path") @db.VarChar(500)
  fileSize    Int       @map("file_size")
  mimeType    String    @map("mime_type") @db.VarChar(100)
  width       Int       @default(320)
  height      Int       @default(160)
  storageType String    @default("RUSTFS") @map("storage_type") @db.VarChar(20)
  folderId    String?   @map("folder_id")
  isEnabled   Boolean   @default(true) @map("is_enabled")
  sortOrder   Int       @default(0) @map("sort_order")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  creator     User?     @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([deletedAt])
  @@index([isEnabled])
  @@index([sortOrder])
  @@map("captcha_backgrounds")
}

model ConsumablePrice {
  id                 String             @id @default(uuid()) @db.Uuid
  consumableId       String             @map("consumable_id") @db.Uuid
  supplierId         String             @map("supplier_id") @db.Uuid
  unitPrice          Decimal            @map("unit_price") @db.Decimal(10, 4)
  effectDate         DateTime           @map("effect_date")
  isCurrent          Boolean            @default(true) @map("is_current")
  batchNote          String?            @map("batch_note") @db.VarChar(200)
  createdAt          DateTime           @default(now()) @map("created_at")
  createdBy          String?            @map("created_by") @db.Uuid
  consumable         Consumable         @relation(fields: [consumableId], references: [id])
  consumableSupplier ConsumableSupplier @relation(fields: [supplierId], references: [id])

  @@index([consumableId])
  @@index([isCurrent])
  @@index([supplierId])
  @@map("consumable_prices")
}

model ConsumableSupplier {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @db.VarChar(200)
  code             String            @unique @db.VarChar(100)
  sortOrder        Int               @default(0) @map("sort_order")
  contact          String?           @db.VarChar(100)
  phone            String?           @db.VarChar(50)
  status           SupplierStatus    @default(ACTIVE)
  remark           String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  createdBy        String?           @map("created_by") @db.Uuid
  updatedBy        String?           @map("updated_by") @db.Uuid
  consumablePrices ConsumablePrice[]
  paymentRecords   PaymentRecord[]
  purchaseReceiptItems PurchaseReceiptItem[]

  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
  @@index([sortOrder])
  @@map("consumable_suppliers")
}

model Consumable {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @db.VarChar(200)
  code                       String                      @unique @db.VarChar(100)
  sortOrder                  Int                         @default(0) @map("sort_order")
  category                   ConsumableCategory
  specDesc                   String?                     @map("spec_desc")
  image                      String?                     @db.Uuid
  status                     ConsumableStatus            @default(ENABLED)
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  deletedAt                  DateTime?                   @map("deleted_at")
  createdBy                  String?                     @map("created_by") @db.Uuid
  updatedBy                  String?                     @map("updated_by") @db.Uuid
  remark                     String?
  consumablePrices           ConsumablePrice[]
  finishedProductConsumables FinishedProductConsumable[]
  purchaseReceiptItems       PurchaseReceiptItem[]

  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
  @@index([sortOrder])
  @@map("consumables")
}

model ContentVersion {
  id             String    @id @default(uuid())
  contentType    String    @map("content_type") @db.VarChar(50)
  contentId      String    @map("content_id") @db.VarChar(100)
  versionNumber  Int       @map("version_number")
  content        Json
  htmlContent    String?   @map("html_content")
  versionType    String    @map("version_type") @db.VarChar(20)
  versionName    String?   @map("version_name") @db.VarChar(100)
  characterCount Int?      @map("character_count")
  wordCount      Int?      @map("word_count")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([contentType, contentId, versionNumber])
  @@index([contentType, contentId])
  @@index([createdAt])
  @@index([createdBy])
  @@index([versionType])
  @@map("content_versions")
}

model EmailLog {
  id           String    @id @default(uuid())
  to           String    @db.VarChar(255)
  subject      String    @db.VarChar(500)
  template     String    @db.VarChar(100)
  templateData Json?     @map("template_data")
  status       String    @default("PENDING") @db.VarChar(20)
  errorMessage String?   @map("error_message")
  retryCount   Int       @default(0) @map("retry_count")
  sentAt       DateTime? @map("sent_at")
  userId       String?   @map("user_id")
  category     String    @default("system") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
  @@index([template])
  @@index([to])
  @@index([userId])
  @@map("email_logs")
}

model ExportTask {
  id            String   @id @default(uuid())
  taskNo        String   @unique @map("task_no") @db.VarChar(50)
  module        String   @db.VarChar(50)
  type          String   @db.VarChar(20)
  format        String   @db.VarChar(20)
  status        String   @default("pending") @db.VarChar(20)
  params        Json?
  fileName      String?  @map("file_name") @db.VarChar(255)
  filePath      String?  @map("file_path") @db.VarChar(500)
  fileSize      BigInt?  @map("file_size")
  totalRows     Int?     @map("total_rows")
  processedRows Int?     @default(0) @map("processed_rows")
  errorMessage  String?  @map("error_message")
