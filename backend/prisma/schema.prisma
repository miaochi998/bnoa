// ==================== 系统升级模块 ====================

model SystemVersion {
  id            String    @id @default(uuid()) @db.Uuid
  version       String    @unique @db.VarChar(50)
  isCurrent     Boolean   @default(false) @map("is_current")
  backendImage  String?   @map("backend_image") @db.VarChar(255)
  frontendImage String?   @map("frontend_image") @db.VarChar(255)
  releaseNotes  String?   @map("release_notes")
  releaseDate   DateTime? @map("release_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("system_versions")
}

model UpgradeLog {
  id           String    @id @default(uuid()) @db.Uuid
  versionFrom  String    @map("version_from") @db.VarChar(50)
  versionTo    String    @map("version_to") @db.VarChar(50)
  upgradeType  String    @default("upgrade") @map("upgrade_type") @db.VarChar(20)
  status       String    @default("running") @db.VarChar(20)
  backupFile   String?   @map("backup_file") @db.VarChar(500)
  backupSize   BigInt?   @map("backup_size")
  backupAt     DateTime? @map("backup_at")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  durationMs   Int?      @map("duration_ms")
  stepsLog     Json?     @map("steps_log")
  errorMessage String?   @map("error_message")
  operatorId   String?   @map("operator_id")
  operatorIp   String?   @map("operator_ip") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  operator User? @relation("userUpgradeLogs", fields: [operatorId], references: [id])

  @@index([status])
  @@index([startedAt])
  @@map("upgrade_logs")
}

// ==================== 系统备份模块 ====================

model BackupLog {
  id           String    @id @default(uuid()) @db.Uuid
  backupType   String    @map("backup_type") @db.VarChar(20)
  triggerType  String    @map("trigger_type") @db.VarChar(20)
  status       String    @default("running") @db.VarChar(20)
  storageType  String    @map("storage_type") @db.VarChar(20)
  storagePath  String?   @map("storage_path") @db.VarChar(500)
  fileSize     BigInt?   @map("file_size")
  checksum     String?   @map("checksum") @db.VarChar(64) // SHA256 checksum，用于验证备份文件完整性
  contentTypes String[]  @default([]) @map("content_types")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  durationMs   Int?      @map("duration_ms")
  errorMessage String?   @map("error_message") @db.Text
  operatorId   String?   @map("operator_id")
  operatorIp   String?   @map("operator_ip") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  operator     User?        @relation("userBackupLogs", fields: [operatorId], references: [id])
  restoreLogs  RestoreLog[] @relation("BackupRestore")
  autoRestores RestoreLog[] @relation("AutoBackupRestore")

  @@index([status])
  @@index([startedAt])
  @@index([triggerType])
  @@map("backup_logs")
}

// ==================== 系统恢复模块 ====================

model RestoreLog {
  id           String    @id @default(uuid()) @db.Uuid
  backupId     String    @map("backup_id") @db.Uuid
  restoreType  String    @default("FULL") @map("restore_type") @db.VarChar(20)
  status       String    @default("running") @db.VarChar(20)
  contentTypes String[]  @default([]) @map("content_types")
  autoBackupId String?   @map("auto_backup_id") @db.Uuid
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  durationMs   Int?      @map("duration_ms")
  stepsLog     Json?     @map("steps_log")
  errorMessage String?   @map("error_message") @db.Text
  operatorId   String?   @map("operator_id")
  operatorIp   String?   @map("operator_ip") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  backup     BackupLog  @relation("BackupRestore", fields: [backupId], references: [id], onDelete: Cascade)
  autoBackup BackupLog? @relation("AutoBackupRestore", fields: [autoBackupId], references: [id], onDelete: Cascade)
  operator   User?      @relation("userRestoreLogs", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([backupId])
  @@index([status])
  @@index([startedAt])
  @@map("restore_logs")
}

