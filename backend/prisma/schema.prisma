  status     NumberRecordStatus @default(ACTIVE)
  createdBy  String?            @map("created_by")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  batch   NumberCheckBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  creator User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([code, status])
  @@index([batchId])
  @@index([status])
  @@index([importedAt])
  @@index([isSettled])
  @@index([createdBy])
  @@index([createdAt])
  @@map("number_check_records")
}

enum NumberRecordStatus {
  ACTIVE
  VOID

  @@map("number_record_status")
}

// ─────────────────────────── 付款记录模块 ───────────────────────────

model PaymentRecord {
  id                   String          @id @default(uuid()) @db.Uuid
  recordNo             String          @unique @map("record_no") @db.VarChar(50)
  title                String          @db.VarChar(200)
  amount               Decimal         @db.Decimal(12, 2)
  currency             PaymentCurrency @default(CNY)
  paymentTime          DateTime        @map("payment_time")
  paymentType          PaymentType    @map("payment_type")
  receiverType         ReceiverType    @map("receiver_type")
  receiverName         String?         @map("receiver_name") @db.VarChar(200)
  supplierId           String?         @map("supplier_id") @db.Uuid
  consumableSupplierId String?         @map("consumable_supplier_id") @db.Uuid
  customReceiverName   String?         @map("custom_receiver_name") @db.VarChar(200)
  payMethod            PayMethod       @map("pay_method")
  fromAccount          String?         @map("from_account") @db.VarChar(200)
  invoiceStatus        InvoiceStatus   @map("invoice_status")
  status               PaymentStatus   @default(DRAFT)
  payerId              String          @map("payer_id")
  remark               String?
  deletedAt            DateTime?       @map("deleted_at")
  createdBy            String?         @map("created_by")
  updatedBy            String?         @map("updated_by")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  payer              User               @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)
  supplier           Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  consumableSupplier ConsumableSupplier? @relation(fields: [consumableSupplierId], references: [id], onDelete: SetNull)
  bills              PaymentBill[]
  attachments        PaymentAttachment[]
  purchaseReceiptLinks PaymentRecordPurchaseReceipt[]

  @@index([paymentTime])
  @@index([paymentType])
  @@index([receiverType])
  @@index([supplierId])
  @@index([consumableSupplierId])
  @@index([payerId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("payment_records")
}

model PaymentBill {
  id              String    @id @default(uuid()) @db.Uuid
  paymentRecordId String    @map("payment_record_id") @db.Uuid
  billNumber      String    @map("bill_number") @db.VarChar(100)
  billDate        DateTime? @map("bill_date")
  billAmount      Decimal?  @map("bill_amount") @db.Decimal(12, 2)
  billFileId      String?   @map("bill_file_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  paymentRecord PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  billFile      File?         @relation("PaymentBillFile", fields: [billFileId], references: [id], onDelete: SetNull)

  @@index([paymentRecordId])
  @@index([billFileId])
  @@map("payment_bills")
}

model PaymentAttachment {
  id              String                 @id @default(uuid()) @db.Uuid
  paymentRecordId String                 @map("payment_record_id") @db.Uuid
  type            PaymentAttachmentType
  fileId          String                 @map("file_id")
  remark          String?
  createdAt       DateTime               @default(now()) @map("created_at")

  paymentRecord PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  file          File          @relation("PaymentAttachmentFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([paymentRecordId])
  @@index([fileId])
  @@index([type])
  @@map("payment_attachments")
}

enum PaymentCurrency {
  CNY
  USD
  EUR
  OTHER

  @@map("payment_currency")
}

enum PaymentType {
  GOODS
  FREIGHT
  CONSUMABLE
  PROMOTION
  SERVICE
  REFUND
  OTHER

  @@map("payment_type")
}

enum ReceiverType {
  SUPPLIER
  CONSUMABLE_SUPPLIER
  CUSTOM

  @@map("payment_receiver_type")
}

enum PayMethod {
  CORPORATE_TRANSFER
  PERSONAL_TRANSFER
  CASH
  ACCEPTANCE
  OTHER

  @@map("payment_pay_method")
}

enum InvoiceStatus {
  PENDING
  ISSUED
  NOT_REQUIRED
  VOID

  @@map("payment_invoice_status")
}

enum PaymentStatus {
  DRAFT
  PAID
  FAILED
  CANCELLED

  @@map("payment_status")
}

enum PaymentAttachmentType {
  SCREENSHOT
  INVOICE

  @@map("payment_attachment_type")
}

// ==================== 进货入库记录模块 ====================

enum PurchaseItemType {
  PRODUCT
  CONSUMABLE
  OTHER

  @@map("purchase_item_type")
}

enum PurchaseImageType {
  BILL
  GOODS

  @@map("purchase_image_type")
}

enum PurchaseBillNoSource {
  AI
  MANUAL
  AUTO_NO_PAPER
  NONE

  @@map("purchase_bill_no_source")
}

model PurchaseReceipt {
  id           String               @id @default(uuid()) @db.Uuid
  receiptNo    String               @unique @map("receipt_no") @db.VarChar(50)
  receiptTime  DateTime             @map("receipt_time")
  billNo       String?              @map("bill_no") @db.VarChar(100)
  billNoSource PurchaseBillNoSource @default(NONE) @map("bill_no_source")
  billAmount   Decimal?             @map("bill_amount") @db.Decimal(14, 2)
  isAccurate   Boolean              @default(true) @map("is_accurate")
  remark       String?
  checkerId    String               @map("checker_id")
  createdBy    String?              @map("created_by")
  updatedBy    String?              @map("updated_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  checker      User                          @relation("PurchaseReceiptChecker", fields: [checkerId], references: [id], onDelete: Restrict)
  items        PurchaseReceiptItem[]
  images       PurchaseReceiptImage[]
  paymentLinks PaymentRecordPurchaseReceipt[]

  @@index([receiptTime])
  @@index([billNo])
  @@index([checkerId])
  @@index([createdBy])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                   String            @id @default(uuid()) @db.Uuid
  receiptId            String            @map("receipt_id") @db.Uuid
  itemType             PurchaseItemType  @map("item_type")
  sortOrder            Int               @default(0) @map("sort_order")
  productId            String?           @map("product_id") @db.Uuid
  supplierId           String?           @map("supplier_id") @db.Uuid
  supplierProductId    String?           @map("supplier_product_id") @db.Uuid
  consumableId         String?           @map("consumable_id") @db.Uuid
  consumableSupplierId String?           @map("consumable_supplier_id") @db.Uuid
  itemName             String            @map("item_name") @db.VarChar(200)
  supplierName         String?           @map("supplier_name") @db.VarChar(200)
  specName             String?           @map("spec_name") @db.VarChar(200)
  quantityText         String            @map("quantity_text") @db.VarChar(200)
  remark               String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  receipt            PurchaseReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product            Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier           Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierProduct    SupplierProduct?   @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  consumable         Consumable?        @relation(fields: [consumableId], references: [id], onDelete: SetNull)
  consumableSupplier ConsumableSupplier? @relation(fields: [consumableSupplierId], references: [id], onDelete: SetNull)
  images             PurchaseReceiptImage[]

  @@index([receiptId])
  @@index([productId])
  @@index([supplierId])
  @@index([consumableId])
  @@index([consumableSupplierId])
  @@index([itemType])
  @@map("purchase_receipt_items")
}

model PurchaseReceiptImage {
  id        String             @id @default(uuid()) @db.Uuid
  receiptId String             @map("receipt_id") @db.Uuid
  itemId    String?            @map("item_id") @db.Uuid
  fileId    String             @map("file_id")
  type      PurchaseImageType
  sortOrder Int                @default(0) @map("sort_order")
  createdAt DateTime           @default(now()) @map("created_at")

  receipt PurchaseReceipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    PurchaseReceiptItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  file    File                @relation("PurchaseReceiptImageFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([itemId])
  @@index([fileId])
  @@index([type])
  @@map("purchase_receipt_images")
}

model PaymentRecordPurchaseReceipt {
  paymentRecordId   String   @map("payment_record_id") @db.Uuid
  purchaseReceiptId String   @map("purchase_receipt_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String?  @map("created_by")

  paymentRecord   PaymentRecord   @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)

  @@id([paymentRecordId, purchaseReceiptId])
  @@index([purchaseReceiptId])
  @@map("payment_record_purchase_receipts")
}
