# 应用配置
NODE_ENV=development
PORT=3000
API_PREFIX=api

# 数据库配置
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bnoa?schema=public"

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# 数据库初始化（seed）用：仅在需要**新建** admin 用户时必填；库中已存在 admin 时无需设置
# 原因：为避免明文口令进入版本库，prisma/seed.ts 与 scripts/seed.js 不再内置默认口令
SEED_ADMIN_PASSWORD=

# S3/RustFS配置
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=bnoa-files
S3_PUBLIC_URL=http://localhost:9000/bnoa-files

# 文件上传配置
UPLOAD_MAX_FILE_SIZE=1073741824
UPLOAD_CHUNK_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/*,video/*,audio/*,application/pdf,text/*,application/zip,application/x-rar-compressed,application/x-7z-compressed,application/gzip,application/x-tar,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/octet-stream

# 缩略图配置
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300
THUMBNAIL_QUALITY=80

# Redis配置（可选，用于缓存和会话）
REDIS_URL=redis://localhost:6379

# 日志配置
LOG_LEVEL=debug
LOG_FORMAT=combined