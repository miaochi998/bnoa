# ============================================
# BNOA 生产环境配置文件
# 复制此文件为 .env.production 并填写实际值
# ============================================

# --- Docker 镜像 ---
DOCKER_IMAGE_PREFIX=miaochi/bnoa
APP_VERSION=latest

# --- 数据库 ---
DB_USER=postgres
DB_PASSWORD=你的数据库密码
DB_NAME=bnoa

# --- JWT ---
JWT_SECRET=你的JWT密钥（建议32位以上随机字符串）
JWT_EXPIRATION=1h
REFRESH_TOKEN_EXPIRATION=7d

# --- CORS ---
CORS_ORIGIN=https://your-domain.example.com

# --- 端口映射 ---
BACKEND_PORT=6520
FRONTEND_PORT=6521
